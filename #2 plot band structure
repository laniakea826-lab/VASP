# function 1. get weights correspond to each orbital and atom.
def get_fatband_weights(ion_indices, orb_indices):
    raw_data_list = [orb_data_loaded[i] for i in ion_indices]
    combined_data = np.array(raw_data_list)
    atom_use_data = np.sum(combined_data, axis=0)
    
    weights_kpts_bands = np.sum(atom_use_data[:, :, orb_indices[0]:orb_indices[-1]+1], axis=2)
    
    weights_selected = weights_kpts_bands[:, band_use - 1]
    
    return weights_selected.flatten(order='F') * (200 / len(ion_indices)) * 0.3



